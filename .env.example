# Copy to .env and fill in. Never commit the real .env — it is gitignored.

# --- Database (Neon Postgres) ---
# Pooled connection used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Direct (unpooled) connection used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Auth (NextAuth) ---
# Generate with: npx auth secret
AUTH_SECRET="replace-me"
# Full origin this instance is served from, e.g. http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"

# --- Public URLs ---
# Read by src/lib/site-config.ts. Both are NEXT_PUBLIC_, so they are inlined at
# BUILD time — set them in the build environment and rebuild to change them.
# Both have working fallbacks in code, so local development needs neither.
#
# The marketing/SEO site: metadataBase, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL="https://splizo.codedharma.com"
# Where the running app lives. The launch page's sign-up and log-in buttons
# point here. Change this when the beta moves off its subdomain.
NEXT_PUBLIC_APP_URL="https://beta.splizo.codedharma.com"
