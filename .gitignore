# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which carries no secrets
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
logs/

# Brand media. The PNGs are regenerated by the scripts next to them
# (`node brand/build-brand.mjs`, `build-campaign.mjs`); the Veo clips are not
# regenerable but cost credits, so they stay local rather than on the server.
brand/icons/
brand/social/
brand/campaign/
brand/logo/*.png
brand/.reel-frames/
brand/cartoon/**/*.mp4
brand/cartoon/**/*.png
*.zip

# Marketing/campaign generators and planning kept out of the app repo.
# NOTE: the older brand/build-*.mjs scripts were committed before this rule, and
# .gitignore does not untrack what is already tracked — use `git rm --cached` if
# you want those out too.
brand/build-covers.mjs
brand/build-dhanteras.mjs
brand/build-launch.mjs
brand/marketing-plan.md

# ffmpeg render logs from the reel builds
*.log
